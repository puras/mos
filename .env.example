# MoS 应用层配置模板：复制为 .env 使用。
# 环境变量优先于 .env 文件（.env 不覆盖已存在的环境变量）。
#
# --- 协议与密钥 ---
MOS_PROVIDER=openai                 # openai / anthropic / mock；无 API Key 时自动降级 mock
# OPENAI_API_KEY=sk-xxx             # OpenAI 兼容服务密钥（DeepSeek / 通义千问 / GLM / Ollama 等）
# ANTHROPIC_API_KEY=sk-ant-xxx      # Anthropic 服务密钥
# MOS_BASE_URL=https://api.deepseek.com/v1
# MOS_MODEL=deepseek-chat
#
# --- 智能体运行配置 ---
# MOS_SYSTEM_PROMPT=你是 MoS 智能体
# MOS_MAX_ITERATIONS=10
# MOS_SHELL_ALLOW=ls, cat, pwd
# MOS_WORKDIR=./workspace
