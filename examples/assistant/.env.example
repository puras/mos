# MoS 应用层配置模板：复制为 .env 使用。
# 环境变量优先于 .env 文件（.env 不覆盖已存在的环境变量）。
#
# --- 协议与密钥 ---
MOS_PROVIDER=openai                 # openai / anthropic / gemini / mock；无 API Key 时自动降级 mock
# OPENAI_API_KEY=sk-xxx             # OpenAI 兼容服务密钥（DeepSeek / 通义千问 / GLM / Ollama 等）
# ANTHROPIC_API_KEY=sk-ant-xxx      # Anthropic 服务密钥
# GEMINI_API_KEY=                   # Gemini 服务密钥
# MOS_BASE_URL=https://api.deepseek.com/v1
# MOS_MODEL=deepseek-chat
#
# --- 智能体运行配置 ---
# MOS_SYSTEM_PROMPT=你是 MoS 智能体
# MOS_MAX_TURNS=10
# MOS_TOOLS=calculator, current_time   # 按需启用的工具，逗号分隔；空表示全部
# MOS_SHELL_ALLOW=ls, cat, pwd
# MOS_WORKDIR=./workspace
#
# --- 执行沙箱（M1.6，默认开启；MOS_SANDBOX=0 关闭） ---
# MOS_SANDBOX_TIMEOUT=10               # 单次命令超时秒数
# MOS_SANDBOX_MAX_OUTPUT=64            # 输出上限 KB，超出截断丢弃
# MOS_SANDBOX_CPU_SECONDS=0            # CPU 时间上限秒数（0 不限制）
# MOS_SANDBOX_MEM_KB=0                 # 虚拟内存上限 KB（0 不限制）
# MOS_SANDBOX_MAX_FILE_KB=0            # 单文件大小上限 KB（0 不限制）
# MOS_SANDBOX_NO_NET=0                 # 1 开启网络隔离（剥离代理变量，尽力而为）
#
# --- 搜索配置（web_search 工具） ---
# MOS_SEARCH_PROVIDER=duckduckgo      # duckduckgo / tavily / serper / brave / searxng
# MOS_SEARCH_REGION=cn-cn             # duckduckgo 区域参数
# MOS_SEARCH_API_KEY=                 # tavily / serper / brave 的密钥
# MOS_SEARCH_BASE_URL=                # searxng 地址（如 https://searx.example.com），duckduckgo 自定义端点
