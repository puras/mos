# ── 模型 ──
MOS_PROVIDER=openai
MOS_BASE_URL=https://api.openai.com/v1
MOS_MODEL=gpt-4o
MOS_API_KEY=sk-xxx
# 输出上限（可选）：默认 128000 起步，超过模型上限会自动对半降档到能用的值；
# 一般不用配。显式配置后不再自动降档（配置错了会大声报错）
# MOS_MAX_TOKENS=128000

# ── 会话 ──
MOS_SESSION_DIR=data

# ── 系统提示（可选）──
MOS_SYSTEM_PROMPT=

# ── 观测 ──
# MOS_LOG_LLM=0        关闭模型调用日志（默认开启）

# ── 策略（可选）──
# MOS_POLICY=policy.yaml   策略配置文件（YAML）；给出后忽略 MOS_DENY_TOOLS
# MOS_DENY_TOOLS=current_time,shell   禁用指定工具（逗号分隔）
