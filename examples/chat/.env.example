# 协议：openai（兼容 DeepSeek / 通义千问 / GLM / Ollama 等）| anthropic | gemini
MOS_PROVIDER=openai

# 对应协议的密钥（三选一，按 MOS_PROVIDER 取用）
OPENAI_API_KEY=sk-<your-key-here>
ANTHROPIC_API_KEY=sk-ant-<your-key-here>
GEMINI_API_KEY=<your-key-here>

# 可选：自定义网关地址（OpenAI 兼容协议，如 https://api.deepseek.com/v1）
MOS_BASE_URL=

# 模型名（必填）
MOS_MODEL=deepseek-chat

# 可选：系统引导词
MOS_SYSTEM_PROMPT=

# 可选：模型调用观测日志（每次调用在 stderr 打一行），0 关闭
MOS_LOG_LLM=1

# 可选：禁用指定工具（逗号分隔），演示单调守卫拦截；命令行 -deny 会并入
MOS_DENY_TOOLS=
